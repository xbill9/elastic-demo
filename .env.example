# Elasticsearch endpoint of the Serverless project (Project settings -> Endpoints)
ES_URL=https://<project>.es.<region>.elastic.cloud
# Kibana endpoint of the same project
KIBANA_URL=https://<project>.kb.<region>.elastic.cloud
# Admin key for setup (Kibana -> Stack Management -> API keys), used by load.mjs and create-mcp-key.mjs
ES_API_KEY=
# Narrow key for the MCP endpoint, printed by create-mcp-key.mjs
MCP_API_KEY=
INDEX=devto-articles
